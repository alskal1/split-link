<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.splitlink.mapper.ExpenseMapper">

    <!-- 지출 내역 등록 -->
    <insert id="insertExpense"
            parameterType="com.splitlink.entity.Expense"
            useGeneratedKeys="true"
            keyProperty="expenseId"
            keyColumn="expense_id">
        INSERT INTO expenses(
            room_id,
            payer_id,
            title,
            amount,
            currency,
            fx_rate,
            spent_at
        ) VALUES (
            #{roomId},
            #{payerId},
            #{title},
            #{amount},
            #{currency},
            #{fxRate},
            #{spentAt}
        )
    </insert>

    <!-- 지출 분할 참여자 Bulk INSERT -->
    <insert id="insertExpenseMembers">
        INSERT INTO expense_shares (
            expense_id,
            member_id,
            amount
        ) VALUES
        <foreach collection="memberIds" item="memberId" separator=",">
            (
                #{expenseId},
                #{memberId},
                #{amount}
            )
        </foreach>
    </insert>
</mapper>
