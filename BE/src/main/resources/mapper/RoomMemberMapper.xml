<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.splitlink.mapper.RoomMemberMapper">

    <!-- 특정 방(slug)의 전체 멤버 목록 조회 (본인 여부 isSelf, 진입 여부 isActive 포함) -->
    <select id="findRoomMembersBySlug" resultType="com.splitlink.dto.response.ExpenseFormInitResponse$MemberInfo">
        SELECT
            m.member_id AS memberId,
            m.name AS name,
            m.is_active AS isActive,
            CASE
                WHEN m.member_id = #{memberId}
                THEN true
                ELSE false
            END AS isSelf
        FROM members m
            JOIN rooms r ON m.room_id = r.room_id
        WHERE r.slug = #{slug}
    </select>
</mapper>
