<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.splitlink.mapper.MemberMapper">

    <!-- 특정 방(slug)의 전체 멤버 목록 조회 (본인 여부 isSelf, 진입 여부 isActive 포함) -->
    <select id="findRoomMembersBySlug" resultType="com.splitlink.dto.response.ExpenseFormInitResponse$MemberInfo">
        SELECT
        m.member_id AS memberId,
        m.name AS name,
        m.is_active AS isActive,
        CASE
        WHEN m.member_id = #{memberId}
        THEN true
        ELSE false
        END AS isSelf
        FROM members m
        JOIN rooms r ON m.room_id = r.room_id
        WHERE r.slug = #{slug}
    </select>

    <!-- TODO: [DB] 계좌번호 암호화 적용 시 account_number 컬럼 길이 확장 필요 (VARCHAR(50) -> VARCHAR(255)) -->
    <!-- 멤버 ID 기준 계좌 정보 조회 (은행명, 계좌번호) -->
    <select id="findAccountInfoByMemberId" resultType="com.splitlink.dto.response.ExpenseFormInitResponse$AccountInfo">
        SELECT
        bank_name,
        account_number
        FROM members
        WHERE member_id = #{memberId}
    </select>

    <!-- 방 생성 시 초기 멤버 목록 일괄 저장 -->
    <insert id="insertMembers">
        INSERT INTO members (
            room_id,
            name
        ) VALUES
        <foreach collection="memberNames" item="name" separator=",">
            (#{roomId}, #{name})
        </foreach>
    </insert>

    <!-- 멤버 접속 선택 시 활성화 상태 변경 -->
    <update id="updateIsActive">
        UPDATE members
        SET is_active = true
        WHERE member_id = #{memberId}
    </update>

    <!-- 특정 방의 전체 멤버 일괄 삭제 -->
    <delete id="deleteMembersByRoomId">
        DELETE FROM members
        WHERE room_id = #{roomId}
    </delete>

    <!-- 결제자 계좌 정보 업데이트 -->
    <update id="updateAccountInfo">
        UPDATE members
        SET bank_name = #{bankName},
            account_number = #{accountNumber}
        WHERE member_id = #{memberId}
    </update>

    <!-- 지정한 방에 속한 멤버 수 조회 -->
    <select id="countMembersByRoomIdAndMemberIds" resultType="int">
        SELECT count(*)
        FROM members
        WHERE room_id = #{roomId}
            AND member_id IN
            <foreach collection="memberIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
    </select>
</mapper>
