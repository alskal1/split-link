<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.splitlink.mapper.MemberMapper">

    <!-- 방에 속한 초기 멤버 목록 일괄 저장 -->
    <insert id="insertMembers">
        INSERT INTO members (
        room_id, name
        ) VALUES
        <foreach collection="memberNames" item="name" separator=",">
            (#{roomId}, #{name})
        </foreach>
    </insert>

    <!-- 멤버 전체 삭제 -->
    <delete id="deleteMembersByRoomId">
        DELETE FROM members
        WHERE room_id = #{roomId}
    </delete>
</mapper>
