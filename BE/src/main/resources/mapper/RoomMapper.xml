<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.splitlink.mapper.RoomMapper">

    <!-- ================================================================= -->
    <!-- C: CREATE (생성)                                                   -->
    <!-- ================================================================= -->

    <!-- 방 정보 저장 -->
    <insert id="insertRoom" useGeneratedKeys="true" keyProperty="roomId">
        INSERT INTO rooms (
            slug,
            title,
            base_currency,
            pin
        ) VALUES (
            #{slug},
            #{title},
            #{baseCurrency},
            #{pin}
        )
    </insert>

    <!-- ================================================================= -->
    <!-- R: READ (조회)                                                     -->
    <!-- ================================================================= -->

    <!-- slug로 roomId 조회 -->
    <select id="findRoomIdBySlug" resultType="java.lang.Long">
        SELECT room_id
        FROM rooms
        WHERE slug = #{slug}
    </select>

    <!-- [입장코드 입력 페이지용] 방 요약 정보(제목, 멤버 이름 목록) 조회 -->
    <resultMap id="RoomSummaryMap" type="com.splitlink.dto.response.RoomSummaryResponse">
        <result property="title" column="title"/>
        <collection property="memberNames" ofType="string">
            <result column="member_name"/>
        </collection>
    </resultMap>
    <select id="findSummaryBySlug" resultMap="RoomSummaryMap">
        SELECT
            r.title,
            m.name AS member_name
        FROM rooms r
        LEFT JOIN members m ON r.room_id = m.room_id
        WHERE r.slug = #{slug}
    </select>

    <!-- [입장코드 검증용] 정답 입장코드 단건 조회 -->
    <select id="findPinBySlug" resultType="string">
        SELECT pin
        FROM rooms
        WHERE slug = #{slug}
    </select>

    <!-- [메인 정산 페이지용] 방 전체 상세 정보 및 멤버 목록 조회 -->
    <resultMap id="RoomDetailMap" type="com.splitlink.dto.response.RoomDetailResponse">
        <id property="roomId" column="room_id"/>
        <result property="slug" column="slug"/>
        <result property="title" column="title"/>
        <result property="baseCurrency" column="base_currency"/>

        <!-- 멤버 목록 매핑 (Inner Class 구분용 $ 사용) -->
        <collection property="members" ofType="com.splitlink.dto.response.RoomDetailResponse$MemberResponse">
            <id property="memberId" column="member_id"/>
            <result property="name" column="name"/>
        </collection>
    </resultMap>

    <select id="findDetailBySlug" resultMap="RoomDetailMap">
        SELECT
            r.room_id,
            r.slug,
            r.title,
            r.base_currency,
            m.member_id,
            m.name
        FROM rooms r
        LEFT JOIN members m ON r.room_id = m.room_id
        WHERE r.slug = #{slug}
    </select>

    <!-- slug 기준 방 정산 완료 여부 조회 -->
    <select id="findIsClosedBySlug" resultType="java.lang.Boolean">
        SELECT is_closed
        FROM rooms
        WHERE slug = #{slug}
    </select>

    <!-- ================================================================= -->
    <!-- U: UPDATE (수정)                                                   -->
    <!-- ================================================================= -->

    <!-- 방 정보 수정 -->
    <update id="updateRoom">
        UPDATE rooms
        SET
            title = #{title},
            base_currency = #{baseCurrency},
            pin = #{targetPin}
        WHERE slug = #{slug}
    </update>

    <!-- ================================================================= -->
    <!-- D: DELETE (삭제)                                                   -->
    <!-- ================================================================= -->

    <!-- slug 기준 방 삭제 -->
    <delete id="deleteRoom">
        DELETE FROM rooms
        WHERE slug = #{slug}
    </delete>
</mapper>
