<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.splitlink.mapper.RoomMapper">
    <!-- 방 정보 저장 -->
    <insert id="insertRoom" useGeneratedKeys="true" keyProperty="roomId">
        INSERT INTO rooms (
            slug,
            title,
            base_currency,
            pin
        ) VALUES (
            #{slug},
            #{title},
            #{baseCurrency},
            #{pin}
        )
    </insert>

    <!-- 멤버 여러 명을 한번에 저장 -->
    <insert id="insertMembers">
        INSERT INTO members (
            room_id, name
        ) VALUES
        <foreach collection="memberNames" item="name" separator=",">
            (#{roomId}, #{name})
        </foreach>
    </insert>
</mapper>
